{
    "window.autoDetectColorScheme": true,
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontFamily": "Lilex, monospace",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.618,
    "editor.tabSize": 2,
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "on",
    "editor.cursorBlinking": "phase",
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.editor.wrapTabs": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.biome": "explicit",
        "source.organizeImports.biome": "explicit"
    },
    "search.exclude": {
        "**/.turbo": true,
        "**/dist": true,
        "**/graphify-out": true,
        "**/graphify-out/wiki": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "cursor.inlineDiff.enablePerformanceProtection": false,
    "git.blame.editorDecoration.enabled": true,
    "material-icon-theme.activeIconPack": "nest",
    "material-icon-theme.hidesExplorerArrows": true,
    "workbench.tree.indent": 16,
    "terminal.integrated.fontFamily": "'Lilex Nerd Font Mono', monospace",
    "terminal.integrated.fontSize": 15,
    "workbench.preferredDarkColorTheme": "Zed Gruvbox Dark",
    "terminal.integrated.fontLigatures.enabled": true,
    "editor.inlayHints.enabled": "off",
    "githubPullRequests.pullBranch": "never",
    "editor.fontSize": 14,
    "diffEditor.renderSideBySide": false,
    "explorer.confirmDelete": false,
    "cursor.composer.textSizeScale": 1.15
}
